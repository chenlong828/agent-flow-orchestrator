{
  "name": "agent-flow-orchaster",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun test --max-concurrency=1",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test --max-concurrency=1 && bun run docs:check",
    "docs:index": "bun run scripts/scenario-index.ts",
    "docs:check": "bun run scripts/scenario-index.ts --check",
    "quality:report": "bun run scripts/quality-report.ts",
    "quality:gate": "bun run scripts/quality-report.ts --gate",
    "db:start": "bash scripts/pg.sh start",
    "db:stop": "bash scripts/pg.sh stop",
    "db:status": "bash scripts/pg.sh status",
    "db:init": "bun run scripts/db-init.ts",
    "db:migrate": "bun run scripts/db-migrate.ts",
    "db:seed": "bun run scripts/seed.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "oxlint": "^1.90.0",
    "pgsql-ast-parser": "^12.0.2",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2"
  }
}
